RewriteEngine On

# Manche Apache-Konfigurationen (insbesondere mit PHP-FPM via mod_proxy_fcgi)
# reichen den Authorization-Header nicht automatisch an PHP durch - ohne das
# hier würde jeder Bearer-Token-Check scheitern ("Nicht angemeldet"), obwohl
# der Client den Header korrekt sendet (siehe src/Core/Request.php,
# REDIRECT_HTTP_AUTHORIZATION-Fallback).
RewriteCond %{HTTP:Authorization} ^(.*)
RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

# Nur /api/... existiert nicht als echte Datei (z.B. /api/events/5) und wird
# daher intern zum API-Frontcontroller umgeleitet. Alle Client-Seiten
# (login.php, calendar.php, ...) sind echte Dateien und werden von Apache
# ganz normal direkt ausgeliefert - hier greift KEINE Rewrite-Regel.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api/(.*)$ api.php [QSA,L]

# Statische Assets (CSS, Icons, Service Worker, Manifest) ändern sich nur
# bei einem Deploy/Self-Update, nicht zwischen zwei Seitenaufrufen - ohne
# Cache-Header fragt der Browser bei JEDEM Seitenaufruf erneut danach statt
# sie eine Weile lokal zu behalten. manifest.json/sw.js bewusst kurz
# gehalten (Service-Worker-Updates sollen zeitnah ankommen, nicht erst nach
# einer Woche), styles.css/Icons länger.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType application/manifest+json "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <FilesMatch "\.(js|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>
