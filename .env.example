DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=familienkalender
DB_USER=root
DB_PASSWORD=

# Beliebige lange, zufällige Zeichenkette – signiert die Access-Token.
# Erzeugen z.B. mit: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Domain der PWA, für CORS. "*" nur für lokale Entwicklung verwenden.
APP_ALLOWED_ORIGIN=*

# Öffentliche Basis-URL der App (OHNE abschließenden Slash), z.B.
# https://kalender.eastcon.eu - wird NUR für den Link in
# Passwort-Reset-Mails gebraucht (AuthController::requestPasswordReset()).
# Bewusst eine feste Konfiguration statt aus dem Host-Header des Requests
# abgeleitet (der sich fälschen lässt). Bleibt dieser Wert leer, bekommt
# der Nutzer statt eines Links nur den rohen Code zum manuellen Eintragen.
APP_PUBLIC_URL=

# Absenderadresse für Erinnerungs-Mails (bin/send-reminders.php), nutzt die
# eingebaute PHP mail()-Funktion / den Sendmail-MTA des Hosters.
MAIL_FROM=kalender@example.com
MAIL_FROM_NAME=Familienkalender

# Push-Benachrichtigungen (Web Push / VAPID) - benötigt vorher
# `composer install` (siehe README) UND einmalig erzeugte Schlüssel:
#   php bin/generate-vapid-keys.php
# Ohne diese drei Werte bleiben Erinnerungen weiterhin per Mail, Push wird
# einfach nicht angeboten (siehe PushSender::isConfigured()).
VAPID_SUBJECT=mailto:kalender@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
