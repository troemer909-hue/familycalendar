DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=familienkalender
DB_USER=root
DB_PASSWORD=

# Beliebige lange, zufällige Zeichenkette – signiert die Access-Token.
# Erzeugen z.B. mit: php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Domain der PWA, für CORS. "*" nur für lokale Entwicklung verwenden.
APP_ALLOWED_ORIGIN=*

# Öffentliche Basis-URL der App (OHNE abschließenden Slash), z.B.
# https://kalender.eastcon.eu - wird NUR für den Link in
# Passwort-Reset-Mails gebraucht (AuthController::requestPasswordReset()).
# Bewusst eine feste Konfiguration statt aus dem Host-Header des Requests
# abgeleitet (der sich fälschen lässt). Bleibt dieser Wert leer, bekommt
# der Nutzer statt eines Links nur den rohen Code zum manuellen Eintragen.
APP_PUBLIC_URL=

# Absenderadresse für Erinnerungs-, Einladungs- und Passwort-Reset-Mails.
MAIL_FROM=kalender@example.com
MAIL_FROM_NAME=Familienkalender

# Mail-Versandweg: "mail" (Standard) nutzt die eingebaute PHP mail()-
# Funktion / den lokalen Sendmail-MTA des Hosters - funktioniert nur, wenn
# der Host tatsächlich einen konfigurierten MTA hat. "smtp" verschickt
# stattdessen über einen externen SMTP-Server (eigener Mailprovider,
# SendGrid, Mailgun, ...) - für Hosts ohne funktionierenden lokalen MTA
# meist die zuverlässigere Wahl.
MAIL_DRIVER=mail

# Nur relevant bei MAIL_DRIVER=smtp:
SMTP_HOST=
# 587 = STARTTLS (Standard), 465 = implizites TLS/SSL.
SMTP_PORT=587
# "tls" (STARTTLS, Standard), "ssl" (implizit) oder "none" (unverschlüsselt,
# nur für lokale Tests).
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=

# Push-Benachrichtigungen (Web Push / VAPID) - benötigt vorher
# `composer install` (siehe README) UND einmalig erzeugte Schlüssel:
#   php bin/generate-vapid-keys.php
# Ohne diese drei Werte bleiben Erinnerungen weiterhin per Mail, Push wird
# einfach nicht angeboten (siehe PushSender::isConfigured()).
VAPID_SUBJECT=mailto:kalender@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Selbst-Update per Git (siehe README, Abschnitt "Selbst-Update"): setzt
# voraus, dass dieser Ordner ein echter Git-Checkout ist (nicht per ZIP/FTP
# hochgeladen). Standardmäßig AUS, da ein Plattform-Admin damit ein
# Shell-Kommando (`git fetch`/`git merge --ff-only`) auf dem Server
# auslösen kann - erst nach bewusster Entscheidung auf "1" setzen.
ENABLE_SELF_UPDATE=0
# Branch, der beim Selbst-Update gezogen wird. Kommt ausschließlich aus
# dieser Datei, NIE aus der Weboberfläche/dem Request.
SELF_UPDATE_BRANCH=main
